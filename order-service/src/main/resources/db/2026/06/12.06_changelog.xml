<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="005-insert-test-data" author="Yurii Kykot" context="dev">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM customers WHERE email = 'john@example.com'
            </sqlCheck>
        </preConditions>

        <insert tableName="customers">
            <column name="name" value="John Doe"/>
            <column name="email" value="john@example.com"/>
            <column name="phone_number" value="+380991234567"/>
        </insert>

        <insert tableName="items">
            <column name="name" value="Pizza Margherita"/>
            <column name="price" value="12.99"/>
        </insert>

        <insert tableName="items">
            <column name="name" value="Cola"/>
            <column name="price" value="2.50"/>
        </insert>
    </changeSet>

</databaseChangeLog>